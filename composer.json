{
    "name": "blackpig-creatif/confessionnal",
    "description": "A Survey and Form Builder",
    "keywords": [
        "BlackpigCreatif",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "confessionnal"
    ],
    "homepage": "https://github.com/blackpig/confessionnal",
    "support": {
        "issues": "https://github.com/blackpig/confessionnal/issues",
        "source": "https://github.com/blackpig/confessionnal"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Blackpig",
            "email": "stuart@blackpig.eu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "blackpig-creatif/chambre-noir": "^2.0",
        "blackpig-creatif/grimoire": "^2.0",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-translatable": "^6.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "BlackpigCreatif\\Confessionnal\\": "src/",
            "BlackpigCreatif\\Confessionnal\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlackpigCreatif\\Confessionnal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "BlackpigCreatif\\Confessionnal\\ConfessionnalServiceProvider"
            ],
            "aliases": {
                "Confessionnal": "BlackpigCreatif\\Confessionnal\\Facades\\Confessionnal"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
